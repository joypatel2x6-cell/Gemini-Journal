# =====================================================================
# Personal Gemini Journal - Environment Configuration
# =====================================================================

# GEMINI_API_KEY: (Required) Server-side Gemini API key.
# On Vercel: Add this in Project Settings -> Environment Variables.
# Never prefix with VITE_ to prevent client-side exposure.
GEMINI_API_KEY=

# GEMINI_MODEL: (Optional) Configurable model alias. Defaults to gemini-2.5-flash.
# Supported options: gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash

# APP_URL: (Optional) Canonical URL where this app is hosted.
APP_URL=
