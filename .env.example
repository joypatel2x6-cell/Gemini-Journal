# ============================================================
# GEMINI JOURNAL — Environment Variables
# ============================================================

# REQUIRED: Your Google Gemini API key.
# Get one free at: https://aistudio.google.com/app/apikey
#
# LOCAL DEV:  Copy this file to .env.local and paste your key below.
#             The server.ts Express dev server will load it automatically.
#
# VERCEL:     Do NOT commit your real key. Set it in:
#             Vercel Dashboard → Your Project → Settings → Environment Variables
#             Variable name:  GEMINI_API_KEY
#             Variable value: your_actual_key_here
#             Environments:   Production, Preview, Development (check all)
#
GEMINI_API_KEY=your_gemini_api_key_here

# OPTIONAL: Override the primary Gemini model used.
# Valid values: gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash
# If not set, gemini-2.5-flash is used by default.
# GEMINI_MODEL=gemini-2.5-flash

# APP_URL: The URL where this app is hosted (optional, informational only).
# APP_URL=https://your-project.vercel.app
